{
	"apiVersion": 3,
	"name": "jp-form-builder/email",
	"title": "Email",
	"category": "widgets",
	"textdomain": "jp-form-builder",
	"editorScript": "file:./index.js",
	"parent": ["jp-form-builder/form"],
	"attributes": {
		"label": { "type": "string", "default": "" },
		"fieldName": { "type": "string", "default": "" },
		"required": { "type": "boolean", "default": true },
		"helpText": { "type": "string", "default": "" },
		"width": { "type": "string", "enum": ["100", "50", "33"], "default": "100" },
		"placeholder": { "type": "string", "default": "" },
		"replyTo": { "type": "boolean", "default": true }
	},
	"supports": { "html": false }
}
