root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{ts,js,json,yml,yaml}]
indent_size = 2

# Source files, block.json included, use tabs like the @wordpress/scripts lint rules expect.
[src/**]
indent_style = tab

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
